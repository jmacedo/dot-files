# Load only in interactive shell
[[ $- != *i* ]] && return

# Default lang utf-8, respecting previous configured lang
# Utf-8 is necessary to render symbols in terminal.
case "${LC_ALL:-${LC_CTYPE:-${LANG:-"utf8"}}}" in
  *UTF-8*|*UTF8*|*utf8*|*utf-8*) ;;
  *) export LANG=C.UTF-8 LC_ALL=C.UTF-8 ;;
esac

BASH_CONFIG_DIR="~/.config/bash"
INCLUDE_BASHRC="~/.config/bash/include.bashrc"
__include_modules=(
    "aliases.bashrc"
    "completion.bashrc"
    "exports.bashrc"
    "params.bashrc"
    "ps1.bashrc"
)

if [[ ! -r "${INCLUDE_BASHRC}" ]]; then
    cat "# This file is automatically generated. Do not edit it directly. Use '~/.config/bash/*.bashrc' instead." > "${INCLUDE_BASHRC}"

    for __module in ${__include_modules[@]}; do
        cat "${BASH_CONFIG_DIR}/${__module}" >> "${$INCLUDE_BASHRC}"
    done
fi

[[ -r "${INCLUDE_BASHRC}" ]] && source "${INCLUDE_BASHRC}