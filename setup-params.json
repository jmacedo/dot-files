{
    "runtime": {
        "external_libraries": [
            "setup-lib.sh"
        ]
    },
    "custom_directories": {
        "apps_dir": "Apps",
        "list": [
            "Dev",
            "Temp",
            ".docker"
        ]
    },
    "installations_backups": {
        "backup_extension": "bkp",
        "datetime_pattern": "+%Y%m%d%H%M%S"
    },
    "applications": {
        "apt": {
            "list": [
                { "package_name": "git", "custom_commands": [] },
                { "package_name": "curl", "custom_commands": [] },
                { "package_name": "unzip", "custom_commands": [] },
                { "package_name": "vim", "custom_commands": [] },
                { "package_name": "file", "custom_commands": [] },
                { "package_name": "ffmpeg", "custom_commands": [] },
                { "package_name": "xclip", "custom_commands": [] },
                { "package_name": "wl-clipboard", "custom_commands": [] },
                { "package_name": "flatpak", "custom_commands": [] },
                { "package_name": "steam-devices", "custom_commands": [] },
                { "package_name": "build-essential", "custom_commands": [] },
                { "package_name": "gparted", "custom_commands": [] },
                { "package_name": "ca-certificates", "custom_commands": [] },
                { "package_name": "jq", "custom_commands": [] },
                { "package_name": "ripgrep", "custom_commands": [] },
                { "package_name": "libarchive-tools", "custom_commands": [] },
                { "package_name": "clangd", "custom_commands": [] },
                { "package_name": "default-jdk", "custom_commands": [] },
                { "package_name": "golang-go", "custom_commands": [] },
                { "package_name": "pipx", "custom_commands": [] },
                { "package_name": "python3-venv", "custom_commands": [] },
                { "package_name": "php-cli", "custom_commands": [] },
                { "package_name": "composer", "custom_commands": [] }
            ]
        },
        "flatpak": {
            "list": [
                { "package_name": "com.dropbox.Client", "custom_commands": [] },
                { "package_name": "com.google.Chrome", "custom_commands": [] },
                { "package_name": "com.valvesoftware.Steam", "custom_commands": [] },
                { "package_name": "com.visualstudio.code", "custom_commands": [] },
                { "package_name": "io.github.kolunmi.Bazaar", "custom_commands": [] },
                { "package_name": "org.onlyoffice.desktopeditors", "custom_commands": [] },
                { "package_name": "org.gnome.gedit", "custom_commands": [] },
                { "package_name": "de.swsnr.turnon", "custom_commands": [] },
                { "package_name": "org.videolan.VLC", "custom_commands": [] }
            ]
        },
        "binary": {
            "list":[
                {
                    "repo": "neovim/neovim",
                    "bin_name": "nvim",
                    "strip_components": 1,
                    "asset_pattern": "linux-x86_64\\.tar\\.gz$",
                    "custom_commands": []
                },
                { 
                    "repo": "junegunn/fzf",
                    "bin_name": "fzf",
                    "strip_components": 0,
                    "asset_pattern": "linux_amd64\\.tar\\.gz$",
                    "custom_commands": []
                },
                { 
                    "repo": "jesseduffield/lazygit",
                    "bin_name": "lazygit",
                    "strip_components": 0,
                    "asset_pattern": "linux_x86_64\\.tar\\.gz$",
                    "custom_commands": []
                },
                { 
                    "repo": "ajeetdsouza/zoxide",
                    "bin_name": "zoxide",
                    "strip_components": 0,
                    "asset_pattern": "x86_64-unknown-linux-musl\\.tar\\.gz$",
                    "custom_commands": []
                },
                { 
                    "repo": "yorukot/superfile",
                    "bin_name": "spf",
                    "strip_components": 2,
                    "asset_pattern": "linux.*amd64\\.tar\\.gz$",
                    "custom_commands": []
                },
                { 
                    "repo": "tree-sitter/tree-sitter",
                    "bin_name": "tree-sitter",
                    "strip_components": 0,
                    "asset_pattern": "linux-x64\\.zip$",
                    "custom_commands": []
                },                
                { 
                    "repo": "sxyazi/yazi",
                    "bin_name": "yazi",
                    "strip_components": 1,
                    "asset_pattern": "x86_64-unknown-linux-gnu\\.zip$",
                    "custom_commands": []
                },                
                { 
                    "repo": "kovidgoyal/kitty",
                    "bin_name": "kitty",
                    "strip_components": 0,
                    "asset_pattern": "kitty-.*-x86_64\\.txz$",
                    "custom_commands": [
                        "cp -f -- '$CUSTOM_USER_APPS_DIR/kitty/share/applications/kitty.desktop' '$HOME/.local/share/applications/kitty.desktop'",
                        "cp -f -- '$CUSTOM_USER_APPS_DIR/kitty/share/applications/kitty-open.desktop' '$HOME/.local/share/applications/kitty-open.desktop'",
                        "sed -i -e \"s|^Icon=kitty$|Icon=$CUSTOM_USER_APPS_DIR/kitty/share/icons/hicolor/256x256/apps/kitty.png|\" \"$HOME/.local/share/applications/kitty.desktop\" \"$HOME/.local/share/applications/kitty-open.desktop\""
                    ]
                }
            ]
        }
    },
    "fonts": {
        "nerd_fonts": [
            "SourceCodePro",
            "NerdFontsSymbolsOnly"
        ],
        "local_fonts": []
    },
    "dot_files": [
        ".config/bash",
        ".config/kitty",
        ".config/nvim",
        ".config/fzf",
        ".config/lazygit",
        ".config/yazi",
        ".config/superfile",
        ".bashrc",
        ".gitconfig",
        ".gitconfig.local.example",
        ".gitignore",
        ".hidden"
    ]
}